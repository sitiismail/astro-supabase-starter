---
// This is the "frontmatter" where you can add logic later
const pageTitle = "Micro PR | Coming Soon";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
		<style>
			body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; background: #111; color: white; text-align: center; }
			.container { padding: 20px; border: 1px solid #333; border-radius: 12px; background: #1a1a1a; }
			h1 { color: #4f46e5; }
			.btn { display: inline-block; background: #4f46e5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 8px; margin-top: 20px; }
		</style>
	</head>
	<body>
		<div class="container">
			<h1>MicroPR is coming soon</h1>
			<p>We are integrating our digital tools to serve you better.</p>
			<a href="mailto:hello@micropr.work" class="btn">Get in touch</a>
		</div>
	</body>
</html>
